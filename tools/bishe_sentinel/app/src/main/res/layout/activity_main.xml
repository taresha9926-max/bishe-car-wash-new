<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BISHE CAR WASH"
        android:textColor="#38BDF8"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PayGuard Sentinel Companion"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginBottom="30dp" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BISHE PAYGUARD: ACTIVE 🟢"
            android:textColor="#10B981"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoring incoming SMS from 127 and CBE..."
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restart / Keep Alive"
        android:backgroundTint="#0284C7"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBatteryOpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Disable Battery Optimization (Important)"
        android:backgroundTint="#475569"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Developer Diagnostics / Simulation"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnTestTelebirr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Mock Telebirr SMS (350 ETB)"
        android:backgroundTint="#0369A1"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnTestCbe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Mock CBE SMS (1,200 ETB)"
        android:backgroundTint="#7C3AED"
        android:textColor="#FFFFFF" />

</LinearLayout>
